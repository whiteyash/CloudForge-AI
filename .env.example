# Copy this file to .env for local Docker Compose development.
POSTGRES_DB=cloudforge
POSTGRES_USER=cloudforge
POSTGRES_PASSWORD=change-me-for-local-development
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cloudforge
SPRING_DATASOURCE_USERNAME=cloudforge
SPRING_DATASOURCE_PASSWORD=change-me-for-local-development
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
CLOUDFORGE_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Generate a real value before starting the API: openssl rand -base64 32
CLOUDFORGE_JWT_SECRET=replace-with-a-32-byte-base64-secret
NEXT_PUBLIC_API_URL=http://localhost:8000
